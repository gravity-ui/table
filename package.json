{
  "name": "@gravity-ui/table",
  "version": "2.0.0",
  "description": "",
  "license": "MIT",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./build/esm/tanstack.d.ts",
        "default": "./build/esm/tanstack.js"
      },
      "require": {
        "types": "./build/cjs/tanstack.d.ts",
        "default": "./build/cjs/tanstack.js"
      }
    },
    "./tanstack-virtual": {
      "import": {
        "types": "./build/esm/tanstack-virtual.d.ts",
        "default": "./build/esm/tanstack-virtual.js"
      },
      "require": {
        "types": "./build/cjs/tanstack-virtual.d.ts",
        "default": "./build/cjs/tanstack-virtual.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "./build/esm/index.d.ts"
      ],
      "tanstack": [
        "./build/esm/tanstack.d.ts"
      ],
      "tanstack-virtual": [
        "./build/esm/tanstack-virtual.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/table"
  },
  "bugs": {
    "url": "https://github.com/gravity-ui/table/issues"
  },
  "homepage": "https://github.com/gravity-ui/table#readme",
  "scripts": {
    "build": "gulp",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "clean": "gulp clean",
    "lint": "run-p lint:*",
    "lint:js": "eslint --report-unused-disable-directives .",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:prettier": "prettier --check '**/*.{md,yaml,yml,json}'",
    "lint:prettier:fix": "prettier --write '**/*.{md,yaml,yml,json}'",
    "lint:styles": "stylelint 'src/**/*.scss' --report-needless-disables",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "start": "storybook dev -p 6006",
    "test": "jest --passWithNoTests",
    "test-storybook": "test-storybook",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bem-react/classname": "^1.8.0",
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@gravity-ui/eslint-config": "^4.3.2",
    "@gravity-ui/gulp-utils": "^1.2.0",
    "@gravity-ui/icons": "^2.23.1",
    "@gravity-ui/prettier-config": "^1.1.1",
    "@gravity-ui/readme-validator": "^1.3.0",
    "@gravity-ui/stylelint-config": "^5.0.0",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@gravity-ui/uikit": "^8.0.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "^10.6.6",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "gulp": "^5.0.1",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-image-snapshot": "^6.5.2",
    "jest-transform-css": "^6.0.3",
    "lodash": "^4.18.1",
    "nano-staged": "^1.0.2",
    "npm-run-all": "^4.1.5",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1",
    "sass-loader": "^17.1.0",
    "storybook": "^10.6.6",
    "style-loader": "^4.0.0",
    "stylelint": "^16.26.1",
    "stylelint-use-logical": "^2.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@gravity-ui/icons": "^2.0.0",
    "@gravity-ui/uikit": "^8.0.0",
    "lodash": "^4.18.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "nano-staged": {
    "*.{scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{json,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  }
}
